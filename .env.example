# ── Active provider ───────────────────────────────────────────────────────────
# 'deepseek' or 'openai'
FLAIR_PROVIDER=deepseek

# ── DeepSeek ──────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
# V4 (recommended): flash = non-thinking workhorse, pro = reasoner for --think.
# The deepseek-chat/deepseek-reasoner aliases expire on 2026-07-24: use the V4 names.
# On V4 models thinking is controlled via a parameter (flair sets it with --think).
# Note: the V4 API enables thinking BY DEFAULT even without the parameter, so the
# fast model produces short reasoning traces too — that is the intended behavior.
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINK_MODEL=deepseek-v4-pro
DEEPSEEK_TEMPERATURE=0.0
# Thinking depth with --think: 'high' (server default) or 'max'. Field-measured
# on a 4-regime comparison (same real analysis task): 'max' on the opening step
# was both the cheapest AND the most precise regime — fewer steps, no wasted
# actions — so it ships enabled. The API maps low/medium to high and xhigh to
# max. If max-effort chains ever get truncated, raise FLAIR_MAX_TOKENS
# (DeepSeek's own V4 evals run Max with budgets up to 384K tokens: 32000 is a
# safe working value for hard tasks).
DEEPSEEK_REASONING_EFFORT=max
# Opt-in: reasoning depth of the FAST model's default thinking (V4 already thinks
# at 'high' server-side): 'max' = deep reasoning at flash prices, on every step of
# the regular loop (--think steps use DEEPSEEK_REASONING_EFFORT instead).
# Unset = requests unchanged, server default untouched.
# DEEPSEEK_FAST_REASONING_EFFORT=max

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=                       # optional (proxy/Azure-compat)
# Defaults chosen as a cost/effectiveness compromise:
#  - fast (tool loop, non-reasoning): gpt-4.1-mini  (~$0.40/$1.60 per 1M)
#  - thinking (--think, reasoning):   gpt-5-mini     (~$0.25/$2.00 per 1M)
# NB: as the think model stay on gpt-5 / gpt-5-mini / gpt-5.1 or o3. gpt-5.4+
# models support reasoning+tools only on the Responses API, not on the Chat
# Completions API used here: you would get the think model WITHOUT reasoning
# when tools are attached.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_THINK_MODEL=gpt-5-mini
OPENAI_TEMPERATURE=0.0
# reasoning_effort: with --think it is set to 'medium' automatically.
# Override it here (none|minimal|low|medium|high|xhigh, model-dependent):
# OPENAI_REASONING_EFFORT=medium

# ── Generation / loop ─────────────────────────────────────────────────────────
FLAIR_MAX_TOKENS=8000
FLAIR_TIMEOUT=300
FLAIR_MAX_STEPS=60
# With --think: 'first' (default) uses the thinking model only for the turn's
# opening step, then the loop continues on the fast model; 'all' keeps the
# thinking model for EVERY step of the turn — deep reasoning throughout, pairs
# well with the reasoning passback. Costs more (pro cache-miss/output ~3x flash).
# FLAIR_THINK_STEPS=first
# Step cap for the explorer sub-agent (`explore` tool, read-only).
FLAIR_EXPLORER_MAX_STEPS=20
# Concurrent tool execution: when the model emits multiple tool calls in one turn and
# they are ALL non-destructive (read-only), they run in parallel (lower latency on
# reads/searches/explore). Batches with destructive tools, or single calls, stay
# sequential. Output is identical (same order): only speed changes. false = old
# sequential behavior.
FLAIR_PARALLEL_TOOLS=true
# Thread cap per parallel batch (avoids flooding the network with too many requests).
FLAIR_PARALLEL_TOOLS_MAX=8
# Real-time response streaming (true/false). --no-stream disables it.
FLAIR_STREAM=true

# ── Local inference (llama.cpp llama-server, vLLM, LM Studio, ...) ────────────
# # Set the active provider (top of this file) to 'local' for a local server.
# LOCAL_BASE_URL=http://127.0.0.1:8001/v1
# LOCAL_MODEL=qwen3.6-27b            # display name; llama-server ignores it
# LOCAL_THINK_MODEL=                 # unset = same as LOCAL_MODEL (one model in VRAM)
# LOCAL_API_KEY=local                # not verified by llama-server
# LOCAL_TEMPERATURE=                 # unset = the SERVER's sampling wins (recommended)
# With a 64K server context, align flair: FLAIR_CONTEXT_WINDOW=60000

# ── DeepSeek via third-party hosts (OpenRouter, DeepInfra, ...) ───────────────
# The deepseek slot works with ANY OpenAI-compatible endpoint serving DeepSeek
# weights: flair deduces the profile from the endpoint. api.deepseek.com → full
# first-party protocol (reasoning passback, thinking control, peak/off-peak
# billing). Any other host → standard-compat profile: reasoning stripped from
# requests, no proprietary extras (--think = model switch only; thinking follows
# the host defaults), flat pricing. Override detection with
# FLAIR_DEEPSEEK_FIRST_PARTY=true|false (default: auto) — e.g. a reverse proxy
# in front of the official API, or a future official domain.
# Example (DeepInfra — check the current slugs and card on their model page):
# DEEPSEEK_BASE_URL=https://api.deepinfra.com/v1/openai
# DEEPSEEK_API_KEY=...
# DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
# DEEPSEEK_THINK_MODEL=deepseek-ai/DeepSeek-V4-Pro-0813
# FLAIR_PRICE_CACHE_HIT=0.08     # = input price if the host has no cache discount
# FLAIR_PRICE_CACHE_MISS=0.08
# FLAIR_PRICE_OUTPUT=0.18

# ── Vision (images in the conversation) ───────────────────────────────────────
# Per-slot capability flag: enable ONLY if the endpoint really accepts images
# (multipart OpenAI-style content) — e.g. llama-server started with its mmproj
# projector loaded, or a vision-capable hosted model. When enabled, the agent
# gains the `view_image` tool and the REPL accepts /img <path> [prompt]
# (one-shot: -p "..." --image path.png, repeatable). Never auto-detected.
# DEEPSEEK_VISION=false
# OPENAI_VISION=false
# LOCAL_VISION=true
# Images larger than this (longest side, px) are downscaled before sending IF
# Pillow is installed (optional: `pip install pillow`); without it, originals
# are sent as-is. Smaller images = faster server-side encoding, fewer tokens.
# FLAIR_IMAGE_MAX_SIDE=1536
# Estimated tokens per image for the context meter (the real count comes back
# in the API usage; this only drives proactive compaction).
# FLAIR_IMAGE_TOKENS=1200

# ── TLS / custom certificates ─────────────────────────────────────────────────
# Private CA bundle (PEM) used to verify TLS for ANY provider endpoint:
# self-hosted servers with a self-signed certificate (llama-server
# --ssl-key-file/--ssl-cert-file) or corporate networks with TLS inspection.
# The certificate must list the endpoint's IP/hostname in its subjectAltName.
# Replaces SSL_CERT_FILE, which httpx >= 0.28 no longer honors. Unset = default
# trust store (certifi), unchanged.
# FLAIR_CA_BUNDLE=C:\certs\server.crt

# ── Context management (compaction) ───────────────────────────────────────────
# Model window (tokens). Past this fraction, the context gets compacted.
# 120K sits on the good edge of DeepSeek-V4's retrieval plateau: the paper's
# MRCR curve is stable up to 128K, then degrades (0.92 -> 0.82 at 256K -> 0.66
# at 512K). Raising this trades retrieval quality for capacity.
FLAIR_CONTEXT_WINDOW=120000
FLAIR_COMPACT_RATIO=0.75
# Recent messages kept intact when compacting.
FLAIR_COMPACT_KEEP=8
# Token cap for the summary generated during compaction.
FLAIR_COMPACT_SUMMARY_MAX=2000
# Compaction stage 0: before the LLM summary, prune (for free) tool outputs that are
# provably superseded — duplicates, reads of files later overwritten, partial reads
# covered by a later full read. true recommended.
FLAIR_COMPACT_PRUNE=true
# Stage-0 hysteresis: pruning alone skips the LLM summary only if it lands the
# context BELOW threshold by this margin (fraction of the window). The mutation
# has already broken the prefix cache: exiting right at the threshold would pay
# a second break a few steps later. 0 = old behavior (any prune-only exit).
FLAIR_PRUNE_HYSTERESIS=0.10

# ── Filesystem / tools ────────────────────────────────────────────────────────
FLAIR_ROOT=.
FLAIR_READ_MAX=12000
FLAIR_GREP_MAX=6000
FLAIR_CMD_MAX=8000
# Maximum size (chars) of the project map (`repo_map` tool).
FLAIR_REPOMAP_MAX=8000
FLAIR_LISTDIR_MAX=200
FLAIR_SEARCH_MAX=80
FLAIR_SEARCH_SCAN_MAX=200000

# ── Web search (general agent) ────────────────────────────────────────────────
# With TAVILY_API_KEY it uses Tavily (recommended); without, it falls back to
# DuckDuckGo (best-effort).
# TAVILY_API_KEY=tvly-...
FLAIR_WEB_MAX=5

# ── Observability ─────────────────────────────────────────────────────────────
# Folder for the session log (JSONL) and flair.log. Empty = no log.
# Each turn is one JSON line with usage, prefix-cache breaks, tools, and the
# provider/model/cost_usd that served it — enough to compare endpoints later
# without recomputing costs from a price table.
# FLAIR_LOG_DIR=./logs

# ── Sessions ──────────────────────────────────────────────────────────────────
# Where to save/resume sessions (--session, --continue, /save, /load).
# FLAIR_SESSION_DIR=~/.flair/sessions
# Session memory: durable facts jotted by the agent with the `remember` tool,
# injected into the system prompt (stable prefix → cached: costs almost nothing)
# and saved as a <name>.memory.md sidecar next to the session JSON — a plain-text
# file you can edit by hand. Empty injects nothing; it survives compaction and
# /reset. false = the tool does not exist and nothing is injected.
FLAIR_MEMORY=true
# HARD cap of the memory block in chars (~1k tokens at 4000): past it, `remember`
# refuses with a notice and pruning remains a user choice (/memory).
FLAIR_MEMORY_MAX_CHARS=4000

# ── Safety ────────────────────────────────────────────────────────────────────
# false = ask confirmation for edit/write/run_command (with a diff preview). true = no confirmation.
FLAIR_AUTO_APPROVE=false

# Unattended execution: disables destructive tools entirely (writes/edits/
# commands) in both agents. Ideal for read-only scheduled jobs.
FLAIR_READ_ONLY=false

# HARD session cost cap (USD): past it, the task stops (stopped_reason "budget").
# 0 = no limit. Protects against runaway spend in headless use.
FLAIR_MAX_COST=0.0

# Warn when the estimated session cost exceeds this threshold (USD). 0 = disabled.
# FLAIR_COST_WARN=0.50

# ── Cost estimate (USD / 1M tokens) — per-model defaults, overridable ─────────
# Since 2026-08-16 the official DeepSeek API bills peak/off-peak: peak hours are
# 01:00-04:00 and 06:00-10:00 UTC at 2x the off-peak rates. flair prices every
# request in ITS OWN time band automatically; the built-in table is the official
# card verified 2026-08-17. Overrides below win field by field: FLAIR_PRICE_*
# applies in every band, FLAIR_PRICE_*_PEAK (optional) wins during peak hours.
# Example: deepseek-v4-flash official OFF-PEAK prices.
# FLAIR_PRICE_CACHE_HIT=0.007
# FLAIR_PRICE_CACHE_MISS=0.22
# FLAIR_PRICE_OUTPUT=0.66
# FLAIR_PRICE_CACHE_HIT_PEAK=0.014
# FLAIR_PRICE_CACHE_MISS_PEAK=0.44
# FLAIR_PRICE_OUTPUT_PEAK=1.32
